<mvc:View
    controllerName="zpg.mrp.ui.controller.Monitor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:semantic="sap.f.semantic"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="pageMRP" title="MRP Monitor (UC-01)">
        <!-- ===== HEADER BUTTONS ===== -->
        <headerContent>
            <Button id="btnHome" icon="sap-icon://home" text="Home" press="onNavHome"/>
            <Button id="btnRun" icon="sap-icon://refresh" text="Run Monitor" type="Emphasized" press="onRunMonitor"/>
            <Button id="btnSave" icon="sap-icon://save" text="Save Result" press="onSaveResult"/>
            <Button id="btnExport" icon="sap-icon://excel-attachment" text="Export Excel" press="onExportExcel"/>
        </headerContent>

        <content>
            <!-- ====== FILTER BAR ====== -->
            <VBox id="boxFilter" class="sapUiSmallMargin">
                <HBox id="hboxFilterRow" justifyContent="SpaceBetween" alignItems="Center">
                    <Input id="inpPlant" placeholder="🏭 Select Plant..." showValueHelp="true"
                           valueHelpRequest="onValueHelpPlant" width="220px"/>
                    <Input id="inpMatnr" placeholder="📦 Material Number..." showValueHelp="true"
                           valueHelpRequest="onValueHelpMaterial" width="220px"/>
                    <HBox id="hboxPeriod" alignItems="Center">
                        <Text id="lblPeriod" text="📅 Period:" class="sapUiTinyMarginEnd"/>
                        <DatePicker id="dpFrom" placeholder="From" width="130px"/>
                        <DatePicker id="dpTo" placeholder="To" width="130px" class="sapUiTinyMarginBegin"/>
                    </HBox>
                    <HBox id="hboxShortage" alignItems="Center">
                        <CheckBox id="chkShortage" text="Show only shortage" selected="false"/>
                    </HBox>
                    <Button id="btnFilter" icon="sap-icon://filter" text="Apply Filter" press="onFilter"/>
                </HBox>
            </VBox>

            <!-- ===== MASTER–DETAIL LAYOUT ===== -->
            <l:ResponsiveSplitter id="rspSplitterMRP" defaultPane="paneMaster">
                <l:PaneContainer id="paneContainerMRP" orientation="Horizontal">

                    <!-- ========== MASTER TABLE ========== -->
                    <l:SplitPane id="paneMaster">
                        <l:layoutData>
                            <l:SplitterLayoutData id="layoutMaster" size="60%" resizable="true"/>
                        </l:layoutData>

                        <Table id="tblMRPMaster"
                               mode="SingleSelectLeft"
                            
                               selectionChange=".onSelectMRP"
                               class="sapUiSizeCompact"
                               growing="true">
                            <headerToolbar>
                                <OverflowToolbar id="toolbarMaster">
                                    <Title id="titleMaster" text="📦 Material Overview" level="H2"/>
                                    <ToolbarSpacer id="spacerMaster"/>
                                    <Button id="btnReloadMaster" icon="sap-icon://refresh" text="Reload" press="onRunMonitor"/>
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colMatnrMaster"><Text id="txtColMatnr" text="Material"/></Column>
                                <Column id="colMatNameMaster"><Text id="txtColMatName" text="Material Name"/></Column>
                                <Column id="colWerksMaster"><Text id="txtColWerks" text="Plant"/></Column>
                                 <Column id="colPlantNameMaster"><Text id="txtColPlantName" text="Plant Name"/></Column>
                                <Column id="colLgortMaster"><Text id="txtColLgort" text="Storage Loc"/></Column>
                                <Column id="colRiskMaster"><Text id="txtColRisk" text="Risk"/></Column>
                            </columns>

                            <items>
                                <ColumnListItem id="itemMRPMaster">
                                    <cells>
                                        <Text id="txtMatnrMaster" text="{Matnr}"/>
                                        <Text id="txtMatNameMaster" text="{MaterialName}"/>
                                        <Text id="txtWerksMaster" text="{Werks}"/>
                                        <Text id="txtPlantNameMaster" text="{PlantName}"/>
                                        <Text id="txtLgortMaster" text="{Lgort}"/>
                                        <ObjectStatus id="stsRiskMaster"
                                                      text="{path:'RiskFlag',formatter:'.formatter.riskText'}"
                                                      state="{path:'RiskFlag',formatter:'.formatter.riskState'}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </l:SplitPane>

                    <!-- ========== DETAIL PANEL ========== -->
                    <l:SplitPane id="paneDetail">
                        <semantic:SemanticPage id="detailArea" visible="false">
                            <semantic:titleHeading>
                                <Title id="titleDetail" text="{Matnr} - {MaterialName}" level="H2"/>
                            </semantic:titleHeading>

                            <semantic:headerContent>
                                <FlexBox id="boxHeaderDetail" wrap="Wrap">
                                    <ObjectAttribute id="attrPlantDetail" title="Plant" text="{Werks}"/>
                                    <ObjectAttribute id="attrStorageDetail" title="Storage Loc" text="{Lgort}"/>
                                    <ObjectAttribute id="attrPeriodDetail" title="Period" text="{Period}"/>
                                    <ObjectAttribute id="attrNetQtyDetail" title="Net Qty" text="{QtyNet}"/>
                                </FlexBox>
                                <Button id="btnCloseDetail" 
                                        icon="sap-icon://decline" 
                                        tooltip="Close detail" 
                                        type="Transparent" 
                                        press=".onCloseDetail"/>
                            </semantic:headerContent>

                            <semantic:content>
                                <f:Form id="formDetail" editable="false">
                                    <f:title><core:Title id="formTitleDetail" text="Chi tiết MRP"/></f:title>
                                    <f:layout>
                                        <f:ResponsiveGridLayout id="layoutFormDetail"
                                            labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                                            columnsXL="1" columnsL="1" columnsM="1"/>
                                    </f:layout>

                                    <f:formContainers>
                                        <f:FormContainer id="formContainerDetail">
                                            <f:formElements>
                                                <f:FormElement id="feQtyStock" label="Stock Qty">
                                                    <f:fields><Text id="txtQtyStockDetail" text="{QtyStock}"/></f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feQtyRcpt" label="Receipt Qty">
                                                    <f:fields><Text id="txtQtyRcptDetail" text="{QtyRcpt}"/></f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feQtyReq" label="Req. Qty">
                                                    <f:fields><Text id="txtQtyReqDetail" text="{QtyReq}"/></f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feSafetyQty" label="Safety Qty">
                                                    <f:fields><Text id="txtSafetyQtyDetail" text="{SafetyQty}"/></f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feNetQty" label="Net Qty">
                                                    <f:fields>
                                                        <ObjectStatus id="stsNetQtyDetail"
                                                                      text="{QtyNet}"
                                                                      state="{path:'QtyNet',formatter:'.formatter.netState'}"/>
                                                    </f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feRisk" label="Risk">
                                                    <f:fields>
                                                        <ObjectStatus id="stsRiskDetail"
                                                                      text="{path:'RiskFlag',formatter:'.formatter.riskText'}"
                                                                      state="{path:'RiskFlag',formatter:'.formatter.riskState'}"/>
                                                    </f:fields>
                                                </f:FormElement>
                                                <f:FormElement id="feApproval" label="Approval">
                                                    <f:fields>
                                                        <ObjectStatus id="stsApprovalDetail"
                                                                      text="{path:'Status',formatter:'.formatter.approvalText'}"
                                                                      state="{path:'Status',formatter:'.formatter.approvalState'}"/>
                                                    </f:fields>
                                                </f:FormElement>
                                            </f:formElements>
                                        </f:FormContainer>
                                    </f:formContainers>
                                </f:Form>
                            </semantic:content>
                        </semantic:SemanticPage>
                    </l:SplitPane>
                </l:PaneContainer>
            </l:ResponsiveSplitter>

            <!-- ===== PAGINATION ===== -->
            <HBox id="pagerBox" justifyContent="Center" class="sapUiMediumMarginTop">
                <Button id="btnPrev" text="Previous" icon="sap-icon://navigation-left-arrow" press="onPrevPage"/>
                <Text id="txtPageInfo" text="Page 1 / 1" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                <Button id="btnNext" text="Next" icon="sap-icon://navigation-right-arrow" press="onNextPage"/>
            </HBox>

            <!-- ===== FOOTNOTE ===== -->
            <HBox id="hboxNote" justifyContent="Center" class="sapUiSmallMarginTop">
                <Text id="txtNote" text="* Data from OData: ZGW_MRP_MONITOR_SRV / Entity: MRPDiffSet"/>
            </HBox>
        </content>
    </Page>
</mvc:View>
